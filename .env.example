# Copy to .env (git-ignored). Never commit real secrets.
# Razorpay TEST MODE keys (dashboard → Settings → API keys, Test mode). Live keys are refused.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# auto = Razorpay test if test keys are present, else mock.  mock = always offline demo payments.
VIGIL_PAYMENT_PROVIDER=auto
# 1 = force the fully offline demo path regardless of keys
VIGIL_DEMO_MODE=0
VIGIL_PORT=8000
# Background stream of ordinary payments (1 on / 0 off) and its interval in seconds.
# The stream is routine-preserving (each account stays within its own busiest 72 h of history),
# so a 133-account world supports only ~70 payments per 72 h; 20 s spreads them over ~25 min.
VIGIL_AMBIENT=1
VIGIL_AMBIENT_INTERVAL=20
# Optional: VIGIL_DB_PATH=C:\path\to\vigil.db  (default: data/vigil.db)
