# Optional overrides — copy to .env (git-ignored). Every value below is the default.
VIGIL_PORT=8000
# Background stream of ordinary payments (1 on / 0 off) and its tick interval in seconds.
# The stream is routine-preserving: each account stays within its own busiest 72 h of history.
VIGIL_AMBIENT=1
VIGIL_AMBIENT_INTERVAL=3
# VIGIL_DB_PATH=C:\path\to\vigil.db   (default: data/vigil.db)

# Vigil Copilot (optional). With no key the Copilot runs fully offline on deterministic templates.
# Enabling it sends incident facts (synthetic data) to Google's Gemini API. Never commit a real key.
GEMINI_API_KEY=
COPILOT_ENABLED=true
# Model ids: leave empty for the defaults gemini-3.8-flash (fast) and gemini-3.1-pro-preview (deep),
# verified on ai.google.dev on 2026-10-13.
COPILOT_MODEL_FAST=
COPILOT_MODEL_DEEP=
COPILOT_DAILY_TOKEN_CAP=300000
COPILOT_TIMEOUT_S=30
