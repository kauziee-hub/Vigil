# Optional overrides — copy to .env (git-ignored). Every value below is the default.
VIGIL_PORT=8000
# Background stream of ordinary payments (1 on / 0 off) and its tick interval in seconds.
# The stream is routine-preserving: each account stays within its own busiest 72 h of history.
VIGIL_AMBIENT=1
VIGIL_AMBIENT_INTERVAL=3
# VIGIL_DB_PATH=C:\path\to\vigil.db   (default: data/vigil.db)
